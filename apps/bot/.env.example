# ambiente
NODE_ENV=development

# TELEGRAM
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Banco do NotesAPP. Em produção o compose da raiz monta esta variável a partir
# do DB_DSN (../shared.env) + DB_NAME (.env do app) — não precisa definir aqui.
DATABASE_URL=postgres://usuario:senha@server_db_postgres:5432/notesapp

# LoginHub (o bot valida e-mail+senha direto lá antes de vincular o Telegram).
# Defaults do código: URL interna do container e app_id 11 (NotesAPP).
LOGINHUB_API_URL=http://server_loginhub_backend:3000/api
LOGINHUB_APP_ID=11
